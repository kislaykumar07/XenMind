# Copy to .env for local development. All values optional.
APP_NAME=XenMind - AI Agent Reliability Lab
# Database: SQLite by default (local file). For a persistent cloud database,
# set a Postgres URL (e.g. Neon):
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./xenmind.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_USER_MESSAGE_CHARS=4000
